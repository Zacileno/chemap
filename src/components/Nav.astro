---
import { kategorie, TELEFON, TELEFON_HREF } from '../data/katalog';

const cesta = Astro.url.pathname.replace(/\/$/, '') || '/';
const aktualni = (href: string): boolean => href === cesta;
---

<div data-animation="default" class="navbar2_component w-nav" data-collapse="medium" data-duration="400" role="banner" data-nav>
  <div class="navbar2_container">
    <a href="/" aria-current={aktualni('/') ? 'page' : undefined} class:list={['navbar2_logo-link w-nav-brand', { 'w--current': aktualni('/') }]}>
      <img
        src="/assets/67c1bc84d150dc768a261e59_zakladni_varianta_RGB.png"
        srcset="/assets/67c1bc84d150dc768a261e59_zakladni_varianta_RGB-p-500.png 500w, /assets/67c1bc84d150dc768a261e59_zakladni_varianta_RGB.png 1237w"
        sizes="(max-width: 479px) 98vw, (max-width: 1237px) 100vw, 1237px"
        alt="CHEMAP chemické produkty"
        class="navbar2_logo"
      />
    </a>
    <nav role="navigation" class="navbar2_menu is-page-height-tablet w-nav-menu" data-nav-menu>
      <a href="/" aria-current={aktualni('/') ? 'page' : undefined} class:list={['navbar2_link w-nav-link', { 'w--current': aktualni('/') }]}>Úvod</a>
      <div data-delay="200" data-hover="true" class="navbar2_menu-dropdown w-dropdown" data-dropdown>
        <div class="navbar2_dropdwn-toggle w-dropdown-toggle" data-dropdown-toggle>
          <a href="/katalog" aria-current={aktualni('/katalog') ? 'page' : undefined} class:list={['w-inline-block', { 'w--current': aktualni('/katalog') }]}
            ><div>katalog produktů</div></a
          >
          <div class="dropdown-chevron w-embed">
            <svg width=" 100%" height=" 100%" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path
                fill-rule="evenodd"
                clip-rule="evenodd"
                d="M2.55806 6.29544C2.46043 6.19781 2.46043 6.03952 2.55806 5.94189L3.44195 5.058C3.53958 4.96037 3.69787 4.96037 3.7955 5.058L8.00001 9.26251L12.2045 5.058C12.3021 4.96037 12.4604 4.96037 12.5581 5.058L13.4419 5.94189C13.5396 6.03952 13.5396 6.19781 13.4419 6.29544L8.17678 11.5606C8.07915 11.6582 7.92086 11.6582 7.82323 11.5606L2.55806 6.29544Z"
                fill="currentColor"></path>
            </svg>
          </div>
        </div>
        <nav class="navbar2_dropdown-list w-dropdown-list" data-dropdown-list>
          {
            kategorie.map((k) => {
              const href = `/kategorie-produktu/${k.slug}`;
              return (
                <a href={href} aria-current={aktualni(href) ? 'page' : undefined} class:list={['navbar2_dropdown-link w-dropdown-link', { 'w--current': aktualni(href) }]}>
                  {k.nazev}
                </a>
              );
            })
          }
        </nav>
      </div>
      <a href="/kontakty" aria-current={aktualni('/kontakty') ? 'page' : undefined} class:list={['navbar2_link w-nav-link', { 'w--current': aktualni('/kontakty') }]}
        >Kontakty</a
      >
    </nav>
    <div id="w-node-b38970d8-8019-6622-aca8-d80d9205cc77-9205cc5a" class="navbar2_button-wrapper">
      <a href={TELEFON_HREF} class="link-block herolink np-button-mob w-inline-block">
        <div class="lottie-animation" data-lottie="/assets/67c494c6baf7f0c0a14cd1ca_Call.json"></div>
        <div class="text-block np-mob">{TELEFON}</div>
      </a>
      <div class="navbar2_menu-button w-nav-button" role="button" tabindex="0" aria-label="menu" aria-expanded="false" data-nav-button>
        <div class="menu-icon2">
          <div class="menu-icon2_line-top"></div>
          <div class="menu-icon2_line-middle"><div class="menu-icon2_line-middle-inner"></div></div>
          <div class="menu-icon2_line-bottom"></div>
        </div>
      </div>
    </div>
  </div>
  <div class="w-nav-overlay" data-nav-overlay></div>
</div>
