---
/** Black page header with the yellow brand molecules (Katalog, Kontakty, categories). */
import type { KategorieSlug } from '../data/katalog';
import IkonaKategorie from './IkonaKategorie.astro';

interface Props {
  nadpis: string;
  podnadpis: string;
  ikona?: KategorieSlug;
}

const { nadpis, podnadpis, ikona } = Astro.props;
---

<section class="page-hero">
  <div class="page-hero__in">
    {
      ikona && (
        <span class="ikona-kruh ikona-kruh--velka">
          <IkonaKategorie slug={ikona} />
        </span>
      )
    }
    <h1 class="page-hero__nadpis">{nadpis}</h1>
    <p class="page-hero__text">{podnadpis}</p>
  </div>
</section>
