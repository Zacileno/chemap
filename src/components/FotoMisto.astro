---
/**
 * Placeholder for a photo the client will supply (replaces agency stock / AI images).
 * Shows the category icon on a yellow panel; the caption says which photo belongs here.
 */
import type { KategorieSlug } from '../data/katalog';
import IkonaKategorie from './IkonaKategorie.astro';

interface Props {
  ikona: KategorieSlug;
  popisek?: string;
  varianta?: 'zluta' | 'seda';
  class?: string;
}

const { ikona, popisek, varianta = 'zluta', class: className } = Astro.props;
---

<div class:list={['foto-misto', `foto-misto--${varianta}`, className]} role="img" aria-label={popisek ?? 'Ilustrační obrázek'}>
  <IkonaKategorie slug={ikona} class="foto-misto__ikona" />
  {popisek && <span class="foto-misto__popisek">{popisek}</span>}
</div>
