---
import { TELEFON, TELEFON_HREF } from '../data/katalog';
---

<section class="section_cta27 text-color-white">
  <div class="padding-global-4">
    <div class="container-large-5">
      <div class="padding-section-large">
        <div class="cta27_component">
          <div class="text-align-center">
            <div class="max-width-large align-center">
              <div class="margin-bottom margin-small">
                <h2 class="heading-style-h2-4">Potřebujete poradit?<br /><span class="text-span-5">Zavolejte nám nebo napište</span></h2>
              </div>
              <div class="margin-top margin-medium top50">
                <div class="button-group is-center">
                  <a href={TELEFON_HREF} class="button-5 w-button"><strong>{TELEFON}</strong></a>
                  <a href="/kontakty" class="button-5 is-secondary w-button">kontakty</a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="cta27_background-image-wrapper">
    <div class="image-overlay-layer"></div>
    <img src="/img/orig/adobestock-971974179.jpg" alt="" loading="lazy" class="cta27_background-image" />
  </div>
</section>
