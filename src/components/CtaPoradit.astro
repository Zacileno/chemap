---
import { TELEFON, TELEFON_HREF } from '../data/katalog';
---

<section class="cta">
  <div class="cta__in">
    <h2 class="cta__nadpis">
      Potřebujete poradit?<br />
      <span>Zavolejte nám nebo napište</span>
    </h2>
    <div class="cta__tlacitka">
      <a href={TELEFON_HREF} class="btn btn--cerne"><strong>{TELEFON}</strong></a>
      <a href="/kontakty" class="btn btn--obrys">Kontakty</a>
    </div>
  </div>
</section>
