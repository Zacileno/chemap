---
import type { Produkt } from '../data/katalog';
import { najdiKategorii } from '../data/katalog';
import FotoMisto from './FotoMisto.astro';
import IkonaKategorie from './IkonaKategorie.astro';

interface Props {
  produkt: Produkt;
}

const { produkt } = Astro.props;
const kat = najdiKategorii(produkt.kategorie);
---

<article class="karta">
  <a href={`/produkty/${produkt.slug}`} class="karta__odkaz">
    <div class="karta__foto">
      {
        produkt.foto ? (
          <img src={produkt.foto} alt={produkt.nazev} loading="lazy" width="400" height="300" />
        ) : (
          <FotoMisto ikona={produkt.kategorie} varianta="seda" />
        )
      }
    </div>
    <h4 class="karta__nazev">{produkt.nazev}</h4>
  </a>
  <a href={`/kategorie-produktu/${kat.slug}`} class="karta__kategorie" title={kat.nazev} aria-label={kat.nazev}>
    <IkonaKategorie slug={kat.slug} />
  </a>
</article>
