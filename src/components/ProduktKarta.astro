---
import type { Produkt } from '../data/katalog';
import { najdiKategorii } from '../data/katalog';

interface Props {
  produkt: Produkt;
  /** Catalogue cards also show the category icons (as on the original /katalog). */
  sIkonami?: boolean;
}

const { produkt, sIkonami = false } = Astro.props;
const kategorie = produkt.vsechnyKategorie.map(najdiKategorii);
const nazevSoboru = (url: string): string => url.replace(/-500\.webp$/, '.webp');
---

<div role="listitem" class:list={[sIkonami ? 'collection-item w-dyn-item' : 'w-dyn-item']}>
  <a href={`/produkty/${produkt.slug}`} class="product-archive w-inline-block" data-hover-zluta>
    <img
      src={produkt.fotoMala}
      srcset={`${produkt.fotoMala} 500w, ${nazevSoboru(produkt.fotoMala)} 1536w`}
      sizes="(max-width: 479px) 92vw, (max-width: 767px) 45vw, (max-width: 991px) 30vw, 22vw"
      loading="lazy"
      alt=""
      class="image-3"
    />
    <div class="div-block-18"><h4 class="heading">{produkt.nazev}</h4></div>
  </a>
  {
    sIkonami && (
      <div class="collection-list-wrapper w-dyn-list">
        <div role="list" class="collection-list-3 w-dyn-items w-row">
          {kategorie.map((k) => (
            <div role="listitem" class="w-dyn-item w-col w-col-6">
              <a href={`/kategorie-produktu/${k.slug}`} class="link-block-5 w-inline-block">
                <img src={k.ikona} loading="lazy" alt={k.nazev} class="image-6" />
              </a>
            </div>
          ))}
        </div>
      </div>
    )
  }
</div>
