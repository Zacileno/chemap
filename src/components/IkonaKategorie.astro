---
/**
 * New line icons for the product categories (drawn for this site,
 * replacing the agency-made PNG icons). Colour follows `currentColor`.
 */
import type { KategorieSlug } from '../data/katalog';

interface Props {
  slug: KategorieSlug;
  class?: string;
}

const { slug, class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 64 64"
  fill="none"
  stroke="currentColor"
  stroke-width="3.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    slug === 'disperze' && (
      <>
        <path d="M14 22h36l-4 30a4 4 0 0 1-4 3.5H22a4 4 0 0 1-4-3.5z" />
        <path d="M14 22c0-4 8-7 18-7s18 3 18 7" />
        <path d="M22 30c0 6 4 6 4 11a3 3 0 0 0 6 0v-6" />
        <path d="M40 30v8" />
      </>
    )
  }
  {
    slug === 'produkty-pro-slevarenstvi' && (
      <>
        <path d="M8 24h30c0 10-6 17-15 17S8 34 8 24z" />
        <path d="M38 27l16-9" />
        <path d="M14 30h18" />
        <path d="M23 41c0 5 3 7 3 11" />
        <path d="M30 40c1 4 4 6 4 10" />
      </>
    )
  }
  {
    slug === 'produkty-pro-cistirny' && (
      <>
        <path d="M32 24v-3a5 5 0 1 0-5-5" />
        <path d="M32 24L8 42a2 2 0 0 0 1.2 3.6h45.6A2 2 0 0 0 56 42z" />
        <path d="M17 50h30" />
      </>
    )
  }
  {
    slug === 'lepidla-na-drevo' && (
      <>
        <path d="M22 26h20v26a4 4 0 0 1-4 4H26a4 4 0 0 1-4-4z" />
        <path d="M26 26l2-9h8l2 9" />
        <path d="M32 17V8" />
        <path d="M27 38h10" />
        <path d="M27 44h10" />
      </>
    )
  }
  {
    slug === 'organicka-rozpoustedla' && (
      <>
        <path d="M32 8l20 11.5v23L32 54 12 42.5v-23z" />
        <circle cx="32" cy="31" r="9" />
      </>
    )
  }
  {
    slug === 'sorbenty-a-filtrace' && (
      <>
        <path d="M10 14h44L37 34v16l-10 6V34z" />
        <path d="M19 22h26" />
        <circle cx="26" cy="18" r="0.6" />
        <circle cx="34" cy="18" r="0.6" />
        <circle cx="41" cy="18" r="0.6" />
      </>
    )
  }
  {
    slug === 'ostatni-chemie' && (
      <>
        <path d="M26 8h12" />
        <path d="M28 8v16L14 49a4 4 0 0 0 3.5 6h29a4 4 0 0 0 3.5-6L36 24V8" />
        <path d="M19 41h26" />
        <circle cx="29" cy="47" r="1.5" />
        <circle cx="36" cy="50" r="1" />
        <circle cx="34" cy="44" r="1" />
      </>
    )
  }
</svg>
