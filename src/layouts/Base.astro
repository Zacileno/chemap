---
import '@fontsource/comfortaa/400.css';
import '@fontsource/comfortaa/500.css';
import '@fontsource/comfortaa/600.css';
import '@fontsource/comfortaa/700.css';
import '@fontsource/open-sans/300.css';
import '@fontsource/open-sans/400.css';
import '@fontsource/open-sans/500.css';
import '@fontsource/open-sans/600.css';
import '@fontsource/open-sans/700.css';
import '@fontsource/open-sans/800.css';
import '../styles/webflow.css';
import '../styles/head-custom.css';
import '../styles/doplnky.css';
import globalEmbed from '../styles/global-embed.css?raw';
import { getSecret } from 'astro:env/server';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Drobecek {
  nazev: string;
  cesta: string;
}

interface Props {
  title: string;
  description: string;
  /** Body class of the original page template (body, body-2 …). */
  bodyClass: string;
  /** Pages with the page-wrapper + main + global styles embed (all except product detail). */
  obal?: boolean;
  /** Standalone page without navigation and footer (404, as on the original). */
  bezNavigace?: boolean;
  /** Breadcrumb trail for structured data (without the homepage, which is added automatically). */
  drobecky?: Drobecek[];
}

const { title, description, bodyClass, obal = true, bezNavigace = false, drobecky } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', Astro.site);
// The share image must load from the domain where this build actually runs. Until the launch the
// production domain is chemap.vercel.app; once chemap.cz is added in Vercel it switches automatically.
const produkcniDomena = getSecret('VERCEL_PROJECT_PRODUCTION_URL');
const ogImage = new URL('/img/og-chemap.jpg', produkcniDomena ? `https://${produkcniDomena}` : Astro.site);
const site = Astro.site ?? new URL('https://www.chemap.cz');
const jeUvod = Astro.url.pathname === '/' || Astro.url.pathname === '';

/** Facts below are taken from the client's own Kontakty page (verified in ARES). */
const strukturovanaData = jeUvod
  ? [
      {
        '@context': 'https://schema.org',
        '@type': 'Organization',
        '@id': `${site.origin}/#organizace`,
        name: 'CHEMAP, spol. s r.o.',
        url: site.origin,
        logo: new URL('/img/logo.png', site).href,
        telephone: '+420603823916',
        email: 'chemap@chemap.cz',
        foundingDate: '1997',
        taxID: 'CZ25280520',
        identifier: { '@type': 'PropertyValue', propertyID: 'IČO', value: '25280520' },
        address: {
          '@type': 'PostalAddress',
          streetAddress: 'Dašice 475',
          postalCode: '533 03',
          addressLocality: 'Dašice',
          addressCountry: 'CZ',
        },
      },
      {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: 'CHEMAP',
        url: site.origin,
        inLanguage: 'cs',
        publisher: { '@id': `${site.origin}/#organizace` },
      },
    ]
  : drobecky && drobecky.length > 0
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'BreadcrumbList',
          itemListElement: [{ nazev: 'Úvod', cesta: '/' }, ...drobecky].map((d, i) => ({
            '@type': 'ListItem',
            position: i + 1,
            name: d.nazev,
            item: new URL(d.cesta, site).href.replace(/\/$/, d.cesta === '/' ? '/' : ''),
          })),
        },
      ]
    : [];

/** Same Google Tag Manager container as the original site (it also loads the CookieYes banner). */
const GTM_ID = 'GTM-KPHB2GWX';
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="CHEMAP – chemické produkty" />
    <meta property="og:site_name" content="CHEMAP" />
    <meta property="og:locale" content="cs_CZ" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="google-site-verification" content="XGeg_bo-EuKcObf-y0RxWJ496A2iRIlB0JXg5TAfnjM" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <script is:inline>
      // Same html classes the Webflow runtime adds (some styles depend on them).
      (function (d) {
        var n = d.documentElement;
        n.className += ' w-mod-js w-mod-ix';
        if ('ontouchstart' in window || (window.DocumentTouch && d instanceof window.DocumentTouch)) n.className += ' w-mod-touch';
      })(document);
    </script>
    {
      strukturovanaData.map((data) => (
        <script type="application/ld+json" set:html={JSON.stringify(data)} />
      ))
    }
    {/* Google Tag Manager — runs only on the production domain so test deploys don't skew the stats. */}
    <script is:inline define:vars={{ GTM_ID }}>
      if (/(^|\.)chemap\.cz$/.test(location.hostname)) {
        (function (w, d, s, l, i) {
          w[l] = w[l] || [];
          w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
          var f = d.getElementsByTagName(s)[0],
            j = d.createElement(s),
            dl = l != 'dataLayer' ? '&l=' + l : '';
          j.async = true;
          j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
          f.parentNode.insertBefore(j, f);
        })(window, document, 'script', 'dataLayer', GTM_ID);
      }
    </script>
  </head>
  <body class={bodyClass || undefined}>
    {!bezNavigace && <Nav />}
    {
      obal ? (
        <div class="page-wrapper">
          <div class="global-styles w-embed">
            <style is:inline set:html={globalEmbed} />
          </div>
          <main class="main-wrapper">
            <slot />
          </main>
        </div>
      ) : (
        <slot />
      )
    }
    {!bezNavigace && <Footer />}
    <noscript
      ><iframe
        src={`https://www.googletagmanager.com/ns.html?id=${GTM_ID}`}
        height="0"
        width="0"
        style="display:none;visibility:hidden"
        title="Google Tag Manager"></iframe
      ></noscript
    >
    <script>
      import '../scripts/webflow-lite';
    </script>
  </body>
</html>
