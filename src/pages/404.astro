---
import Base from '../layouts/Base.astro';
---

<Base title="Stránka nenalezena | CHEMAP" description="Stránka, kterou hledáte, neexistuje." bodyClass="" obal={false} bezNavigace>
  <div class="utility_component">
    <div class="utility_form-block w-form">
      <img src="/assets/page-not-found.svg" alt="" class="utility_image" />
      <h3>Stránka nenalezena</h3>
      <div class="padding-xxsmall"></div>
      <div>Stránka, kterou hledáte, neexistuje. Vraťte se na úvodní stránku.</div>
      <div class="padding-xxsmall"></div>
      <a href="/" class="button w-button">Jít na hlavní stránku</a>
    </div>
  </div>
</Base>
