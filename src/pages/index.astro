---
import Base from '../layouts/Base.astro';
import { kategorie } from '../data/katalog';
import { seoStranky } from '../data/seo';
import heroIkony from '../styles/hero-ikony.css?raw';

/** Grid ids of the original layout (the original CSS positions these items by id). */
const idVyhod = [
  'w-node-_0b97b90d-b2f6-44c1-c31d-5d1ab8c2b380-90f71737',
  'w-node-_0b97b90d-b2f6-44c1-c31d-5d1ab8c2b386-90f71737',
  'w-node-_0b97b90d-b2f6-44c1-c31d-5d1ab8c2b38c-90f71737',
  'w-node-_07c02462-dac5-7052-219f-407e58dfc2b1-90f71737',
];
const idObrazkuVpravo: Record<number, string> = {
  1: 'w-node-_29f79f18-cdfe-0ea0-6d37-1b490c677dce-90f71737',
  3: 'w-node-_09682d5d-dc7d-3e26-f807-a3a9c85e14bb-90f71737',
};

const vyhody = [
  'Česká firma',
  'Technická podpora a konzultace',
  'Dodání zboží do druhého dne',
  'Laboratorní zkoušky u nás i u zákazníka',
];

const sipka =
  'M21.84 10.11c-1.54-.84-3.57-2-5.72-3.25C12 4.49 7.37 1.82 4.1.22A2.15 2.15 0 0 0 1 2.14v19.72A2.15 2.15 0 0 0 3.16 24a2.12 2.12 0 0 0 .94-.22c3.28-1.6 7.93-4.28 12-6.64 2.14-1.24 4.17-2.4 5.71-3.25a2.12 2.12 0 0 0 0-3.79Z';

interface Karta {
  nadpis: string;
  text: string;
  obrazek: string;
  vpravo: boolean;
}

const karty: Karta[] = [
  {
    nadpis: 'Organická rozpouštědla',
    text: 'Organická rozpouštědla se používají pro výrobu nátěrových hmot, lepidel i v textilním průmyslu. Zajišťují správnou konzistenci, přilnavost i efektivní aplikaci. Vyberte si z naší nabídky kvalitních chemických přípravků.',
    obrazek: '/img/orig/adobestock-391098044.jpg',
    vpravo: false,
  },
  {
    nadpis: 'Akrylátové a vinylacetátové disperze',
    text: 'Akrylátové a vinylacetátové disperze nachází široké uplatnění v průmyslu – od výroby nátěrových hmot, lepidel a tmelů až po penetrace, šlichtování textilií a výrobu přípravků zamezujících okus stromků zvěří. Získejte vynikající výsledky s našimi produkty.',
    obrazek: '/img/orig/adobestock-406500817.jpg',
    vpravo: true,
  },
  {
    nadpis: 'Slévárenské přípravky',
    text: 'Slévárenské přípravky jsou nezbytné pro nátěry forem a jader a také separaci a ředění slévárenských nátěrů, kde zajišťují hladký povrch odlitků, minimalizují vady a usnadňují proces odformování. Nabízíme kvalitní produkty, které přispívají k vyšší efektivitě a přesnosti výroby.',
    obrazek: '/img/orig/adobestock-394691591.jpg',
    vpravo: false,
  },
  {
    nadpis: 'Čistírenská rozpouštědla',
    text: 'Čistírenská rozpouštědla jsou ideální pro standardní i ekologické čištění oděvů, kde efektivně odstraňují nečistoty, oleje a tuky, aniž by poškodily textilní materiály. Prohlédněte si naši nabídku rozpouštědel pro profesionální a ekologicky šetrné čištění.',
    obrazek: '/img/orig/adobestock-376908974.jpg',
    vpravo: true,
  },
];
---

<Base title={seoStranky.uvod.title} description={seoStranky.uvod.description} bodyClass="body">
  <style is:inline set:html={heroIkony}></style>
  <section id="hero" class="section">
    <div class="div-block-24">
      <div class="div-block">
        <h1 data-ix="grow" data-ix-delay="400" style="opacity:0" class="heading-style-h1">
          Přední český <span class="text-span-3">výrobce a distributor</span> chemických látek a přípravků
        </h1>
        <p data-ix="grow" data-ix-delay="1000" style="opacity:0" class="text-size-medium">Zákazníky máme na prvním místě už téměř 30 let</p>
        <div data-ix="grow" data-ix-delay="1600" style="opacity:0" class="layout16_item-list">
          {
            vyhody.map((v, i) => (
              <div id={idVyhod[i]} class="layout16_item">
                <div class="layout16_item-icon-wrapper">
                  <div class="icon-embed-xsmall w-embed">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                      <path fill="#ffe000" d={sipka} />
                    </svg>
                  </div>
                </div>
                <div class="layout16_item-text-wrapper">
                  <p>{v}</p>
                </div>
              </div>
            ))
          }
        </div>
        <div class="margin-top margin-medium">
          <div class="button-group">
            <a data-ix="grow" data-ix-delay="2200" style="opacity:0" href="/katalog" class="button-2 w-button">katalog produktů</a>
          </div>
        </div>
      </div>
      <div class="div-block-2">
        <div class="icons-wrapper" data-kolo>
          {
            kategorie.map((k) => (
              <a href={`/kategorie-produktu/${k.slug}`} class="w-inline-block" aria-label={k.nazev}>
                <div class={`icon-item ${k.kolo}`}>
                  <img src={k.ikonaKolo} alt="" class="default-icon" />
                  <img src={k.ikonaKoloHover} alt="" class="hover-icon" />
                </div>
              </a>
            ))
          }
          <div class="center-text main-text">
            <p class="paragraph-2">Vyberte, co vás zajímá</p>
          </div>
          {
            kategorie.map((k) => (
              <div class={`center-text ${k.kolo}`}>
                <p class="paragraph-2">{k.nazev}</p>
                <p class="paragraph-3">{k.perex}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>
  <section class="section_layout408">
    <div class="padding-global">
      <div class="container-large">
        <div class="padding-section-large bot5">
          <div class="margin-bottom margin-xxlarge">
            <div class="text-align-center">
              <div class="max-width-large align-center">
                <div class="margin-bottom margin-small">
                  <h2 data-ix="grow" data-ix-delay="0" style="opacity:0" class="heading-style-h2">
                    Široký výběr produktů pro vaše <span class="text-span-2">efektivní podnikání</span>
                  </h2>
                </div>
              </div>
            </div>
          </div>
          <div class="w-layout-grid layout408_component" data-ix-karty>
            {
              karty.map((k, i) => (
                <div class={`layout408_card card-${i + 1}`}>
                  {k.vpravo && (
                    <div id={idObrazkuVpravo[i]} class="layout408_image-wrapper right">
                      <img class="layout408_image" src={k.obrazek} alt={k.nadpis} data-ix="grow" data-ix-delay="400" data-ix-offset="40" style="opacity:0" loading="lazy" />
                    </div>
                  )}
                  <div class:list={['layout408_card-content', { left: !k.vpravo }]}>
                    <div class="layout408_card-content-top">
                      <div class="margin-bottom margin-small">
                        <h3 class="heading-style-h3">{k.nadpis}</h3>
                      </div>
                      <p>{k.text}</p>
                    </div>
                    <div class="margin-top margin-medium">
                      <div class="button-group">
                        <a href="/katalog" class="button w-button">katalog produktů</a>
                      </div>
                    </div>
                  </div>
                  {!k.vpravo && (
                    <div class="layout408_image-wrapper">
                      <img class="layout408_image" src={k.obrazek} alt={k.nadpis} data-ix="grow" data-ix-delay="400" data-ix-offset="40" style="opacity:0" loading="lazy" />
                    </div>
                  )}
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>
  <header class="section_header36-2">
    <div class="w-layout-grid header36_component-2">
      <div id="w-node-bf291484-8742-4f9a-9d45-18fdc2c6714e-90f71737" data-ix="grow" data-ix-delay="0" data-ix-offset="25" style="opacity:0" class="header36_content-2">
        <div class="margin-bottom margin-small">
          <h1 class="heading-style-h1-2"><span class="text-span-4">O nás:</span> česká firma s tradicí</h1>
        </div>
        <p class="text-size-medium-2">
          Jsme ryze česká firma s vlastním kapitálem, která sídlí v Dašicích. Už od roku 1997 pomáháme našim zákazníkům v České republice najít ideální
          řešení na míru pro jejich výrobu. Klademe důraz na kvalitu dodávek – jakost zboží, obalů, formální kompletnost dodávek a jejich bezchybné
          logistické zajištění. Jsme v souladu s požadavky norem EN ISO 9001:2008 a ISO 9001:2015, přestože již nejsme držiteli certifikace. Při
          doručování nebezpečného zboží dodržujeme pravidla ADR a využíváme k tomu vlastní dopravní prostředky.<br /><br />Díky našim dlouholetým
          zkušenostem nabízíme zákazníkům nejen kvalitní produkty, ale i technickou podporu a konzultace. V rámci naší politiky se snažíme maximálně
          uspokojit požadavky a potřeby našich odběratelů, stejně tak našich zaměstnanců a ostatních zainteresovaných stran a budujeme dlouhodobé a
          vzájemně prospěšné vztahy.<br />
        </p>
        <div class="margin-top margin-medium">
          <div class="button-group"><a href="/katalog" class="button-2 w-button">katalog produktů</a></div>
        </div>
      </div>
      <div data-ix="slide-right" data-ix-delay="1000" data-ix-offset="25" style="opacity:0" class="header36_image-wrapper-2">
        <img src="/img/orig/adobestock-1057381803.jpg" alt="Laboratorní baňka se žlutou kapalinou" class="header36_image" />
      </div>
    </div>
  </header>
  <div class="background-molekula"></div>
</Base>
