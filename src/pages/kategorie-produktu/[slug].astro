---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import StrankaHero from '../../components/StrankaHero.astro';
import ProduktKarta from '../../components/ProduktKarta.astro';
import { kategorie, produktyVKategorii } from '../../data/katalog';
import type { Kategorie } from '../../data/katalog';
import { seoKategorie } from '../../data/seo';

export const getStaticPaths = (() =>
  kategorie.map((k) => ({ params: { slug: k.slug }, props: { kat: k } }))) satisfies GetStaticPaths;

interface Props {
  kat: Kategorie;
}

const { kat } = Astro.props;
const seznam = produktyVKategorii(kat.slug);
---

<Base
  title={seoKategorie[kat.slug].title}
  description={seoKategorie[kat.slug].description}
  aktivni="katalog"
  drobecky={[
    { nazev: 'Katalog produktů', cesta: '/katalog' },
    { nazev: kat.nazev, cesta: `/kategorie-produktu/${kat.slug}` },
  ]}
>
  <StrankaHero nadpis={kat.nazev} podnadpis="Katalog našich produktů" ikona={kat.slug} />

  <section class="seznam seznam--svetly">
    <div class="mrizka">
      {seznam.map((p) => <ProduktKarta produkt={p} />)}
    </div>
  </section>
</Base>
